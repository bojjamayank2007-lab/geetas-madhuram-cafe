# ─── Geeta's Madhuram Cafe — Backend Environment ─────────────────────────────
# Copy this file to .env and fill in real values. Never commit .env.

# Express server port
PORT=5000

# development | production
NODE_ENV=development

# MongoDB connection string (MongoDB Atlas for production / local mongod for dev)
MONGO_URI=mongodb+srv://<user>:<pass>@cluster.mongodb.net/geetas-madhuram?retryWrites=true&w=majority

# JWT signing secret — use a long random string in production
JWT_SECRET=replace_with_long_random_string
JWT_EXPIRES_IN=7d

# Comma-separated origins allowed to call this API (Vercel frontend goes here)
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:5000

# Razorpay (optional — COD is the default payment method)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Seed admin credentials (used by node seedAdmin.js)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeMe123!

# ─── Email notifications (optional — orders still work without this) ───────
# Gmail SMTP. Enable 2FA on the sender account and create an App Password:
# https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Where to send "new order" alerts (can be the same as SMTP_USER)
NOTIFICATION_EMAIL=
# Public frontend URL, used for "view order" links inside emails
FRONTEND_URL=http://localhost:5500